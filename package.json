{
  "name": "pulumi-package-docs",
  "version": "0.1.1",
  "description": "Local documentation viewer for the parameterized/local Pulumi providers used by a Pulumi project.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Piers Karsenbarg",
    "email": "piers@pulumi.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pierskarsenbarg/pulumi-package-docs.git"
  },
  "bin": {
    "pulumi-package-docs": "bin/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "examples",
    "src",
    "tsconfig.json",
    "vite.config.ts"
  ],
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build && npm run build:mcp",
    "build:mcp": "vite build --config vite.mcp.config.ts",
    "preview": "vite preview",
    "start": "node bin/cli.js",
    "static": "node bin/cli.js static",
    "compile:bun": "node bin/generate-embedded-assets.js && bun build ./bin/cli-bun.js --compile --outfile pulumi-package-docs",
    "test": "vitest run",
    "test:stdio": "node scripts/smoke-test-stdio.js node bin/cli.js --stdio && node scripts/smoke-test-stdio.js ./pulumi-package-docs --stdio",
    "test:watch": "vitest",
    "lint": "oxlint",
    "format": "oxfmt . && oxlint --fix",
    "check": "oxfmt --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^8.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
